<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.nappsllc.rustshot</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Rustshot</name>
  <summary>Screenshots, editing and video capture</summary>
  <developer id="io.github.nappsllc">
    <name>PowerNapps</name>
  </developer>
  <description>
    <p>
      Rustshot captures a region, a window or the whole screen, lets you annotate it (arrows, shapes, text, callouts, blur, numbered tags and more), and copies, saves, pins or uploads it. It also records the screen to MP4 or GIF with sound, microphone and a camera bubble, keeps a history of captures you can re-edit, and recognises text (OCR). One small native binary, no runtime.
    </p>
    <p>
      A small background daemon provides global hotkeys. Works on X11 and
      Wayland (through the desktop portals).
    </p>
  </description>
  <launchable type="desktop-id">io.github.nappsllc.rustshot.desktop</launchable>
  <url type="homepage">https://github.com/nappsllc/rustshot</url>
  <url type="bugtracker">https://github.com/nappsllc/rustshot/issues</url>
  <url type="vcs-browser">https://github.com/nappsllc/rustshot</url>
  <content_rating type="oars-1.1"/>
  <provides>
    <binary>rustshot</binary>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <categories>
    <category>Graphics</category>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>screenshot</keyword>
    <keyword>capture</keyword>
    <keyword>annotate</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Annotating a selection</caption>
      <image>https://raw.githubusercontent.com/nappsllc/rustshot/main/docs/screenshots/overlay-dark.png</image>
    </screenshot>
  </screenshots>
