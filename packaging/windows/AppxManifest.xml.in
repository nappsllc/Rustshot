<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 desktop rescap">
  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Rustshot</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Tiny yet powerful, beautiful, open-source and cross-platform tool for screenshots, editing and video capture</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <!-- One <Resource> per lang/<tag>.txt, en-us first (the default); msix.ps1
       fills them in. The Store lists these as the app's languages. -->
  <Resources>
@RESOURCES@
  </Resources>
  <Applications>
    <Application Id="Rustshot" Executable="rustshot.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Rustshot" Description="Screenshots, editing and video capture"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="rustshot.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="rustshot.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <!-- Win+Shift+S and Print Screen launch ms-screenclip:. Declaring it
             only makes Rustshot a candidate: the user picks it in Settings >
             Apps > Default apps > MS-SCREENCLIP (the app never changes the
             default itself). The URI arrives as `screenclip "<uri>"`. -->
        <uap3:Extension Category="windows.protocol" Executable="rustshot.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:Protocol Name="ms-screenclip" Parameters="screenclip &quot;%1&quot;">
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:DisplayName>Rustshot screen capture</uap:DisplayName>
          </uap3:Protocol>
        </uap3:Extension>
        <!-- The hotkey daemon at sign-in: a plain launch (no arguments) runs
             it. On this entry because the Store refuses an entry hidden
             from Start (a "headless" app) without a waiver. The TaskId is
             0.6.5's, so an update keeps the user's on/off choice. -->
        <desktop:Extension Category="windows.startupTask" Executable="rustshot.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="RustshotDaemon" Enabled="true" DisplayName="Rustshot hotkeys" />
        </desktop:Extension>
      </Extensions>
    </Application>
    <!-- Start menu "Rustshot Settings": the way in with the tray icon off. -->
    <Application Id="RustshotSettings" Executable="rustshot.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="settings">
      <uap:VisualElements DisplayName="Rustshot Settings" Description="Rustshot's settings"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <!-- Recording: the microphone and the camera bubble (Windows asks the
         user; Settings > Privacy lists Rustshot). System sound and the
         screen need no capability. -->
    <DeviceCapability Name="microphone" />
    <DeviceCapability Name="webcam" />
  </Capabilities>
</Package>
